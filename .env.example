# Claude runs through the Claude Code CLI (`claude -p`) with your Claude login; no API key needed.
# CLAUDE_MODEL=opus
# ElevenLabs Greek voice
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL=eleven_multilingual_v2
# Stock footage. Magnific is used first, free stock downloads only (never credits), max MAGNIFIC_DAILY_CAP per day
MAGNIFIC_API_KEY=
# MAGNIFIC_DAILY_CAP=90
# Free fallbacks
PEXELS_API_KEY=
PIXABAY_API_KEY=
# AI thumbnail background (optional; falls back to the lead press photo)
OPENAI_API_KEY=
# YouTube upload: OAuth client file from Google Cloud Console (Desktop app)
YOUTUBE_CLIENT_SECRETS=client_secret.json
# Phone notifications for the two approval gates (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Only needed in containers without Remotion's own Chrome
# REMOTION_CHROME=/path/to/chrome-headless-shell
